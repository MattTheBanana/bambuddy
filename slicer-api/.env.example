# Copy to .env and tweak. Defaults match what Bambuddy expects out of the box.

# Host ports. Bambuddy's virtual-printer feature already binds 3000 and
# 3002, so the OrcaSlicer sidecar sits on 3003. Move them if you run
# this stack on a different host or want to free those ports for VPs.
ORCA_API_PORT=3003
BAMBU_API_PORT=3001

# Address the ports are published on. Unset publishes them on all interfaces.
# The sidecars have no login. For a same-host Bambuddy install using network_mode: host,
# set this to 127.0.0.1 so only the host can reach them. Leave unset for bridge mode
# or when Bambuddy runs on another host.
#SIDECAR_BIND=127.0.0.1
WAVE_API_PORT=3004

# Sidecar image tag. Default is `latest` (current stable release).
# Pinning options:
#   bambuddy-X.Y.Z   pin to the sidecar image that shipped with Bambuddy X.Y.Z
#                    (e.g. SIDECAR_TAG=bambuddy-0.2.5)
#   daily            track the bambuddy:daily channel
SIDECAR_TAG=latest

# OrcaSlicer-WaveOverhangs release for the optional sidecar.
WAVE_OVERHANGS_VERSION=0.4.0

# Largest model file the sidecars will accept for a slice, in megabytes.
# Raise it if a big multi-colour project is rejected as "too large" -- the
# cap is enforced inside the sidecar, so no reverse-proxy body limit affects
# it. Leave it unset for the 512 MB default.
#MAX_MODEL_UPLOAD_MB=512
